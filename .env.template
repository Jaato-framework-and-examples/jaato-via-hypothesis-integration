# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# h (Hypothesis backend)
# These env var names match what h expects (see h/config.py)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/h
ELASTICSEARCH_URL=http://elasticsearch:9200
BROKER_URL=amqp://guest:guest@rabbit:5672//
APP_URL=http://__HOST_IP__:5000
AUTHORITY=__HOST_IP__
SECRET_KEY=notasecret-changeme
H_API_AUTH_COOKIE_SECRET_KEY=notasecret-changeme
H_API_AUTH_COOKIE_SALT=notasecret-changeme
# CLIENT_URL: h redirects /embed.js here. Must point to boot.js (the client entry point)
CLIENT_URL=http://__HOST_IP__:3001/hypothesis/boot.js
# WebSocket runs on the same port as h (5000), differentiated by /ws path
WEBSOCKET_URL=ws://__HOST_IP__:5000/ws
CLIENT_RPC_ALLOWED_ORIGINS=http://__HOST_IP__:9083 http://__HOST_IP__:9085
CLIENT_OAUTH_ID=52a09c02-1aed-11f1-9b30-2357ef0929a2

# Via
# Via's env vars are uppercased versions of the PARAMETERS dict keys in via/app.py
VIA_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/via
VIA_CHECKMATE_URL=http://dummy-checkmate
VIA_CHECKMATE_API_KEY=dummy
VIA_CHECKMATE_ALLOW_ALL=true
VIA_SECRET=notasecret-changeme
VIA_NGINX_SECURE_LINK_SECRET=notasecret-changeme
VIA_NGINX_SERVER=http://__HOST_IP__:9083
# CLIENT_EMBED_URL: boot.js loaded directly from client container (no h redirect)
VIA_CLIENT_EMBED_URL=http://__HOST_IP__:3001/hypothesis/boot.js
# VIA_HTML_URL is used in browser-facing iframe src, must be browser-resolvable
VIA_HTML_URL=http://__HOST_IP__:9085
VIA_DATA_DIRECTORY=/via-data/
VIA_ENABLE_FRONT_PAGE=true
VIA_API_JWT_SECRET=notasecret-changeme

# ViaHTML
# VIA_H_EMBED_URL: injected into proxied HTML pages. Points directly to boot.js
VIAHTML_H_EMBED_URL=http://__HOST_IP__:3001/hypothesis/boot.js
VIAHTML_ROUTING_HOST=http://via:9083
# Referrers allowed to load viahtml content (netloc only, checked against Referer header)
VIA_ALLOWED_REFERRERS=__HOST_IP__:9083
# URLs matching these prefixes are not proxied by pywb (comma-separated, loaded directly by browser)
VIA_IGNORE_PREFIXES=http://__HOST_IP__:3001/,http://__HOST_IP__:5000/
VIAHTML_CHECKMATE_URL=http://dummy-checkmate
VIAHTML_CHECKMATE_API_KEY=dummy
VIAHTML_CHECKMATE_ALLOW_ALL=true
VIAHTML_SECRET=notasecret-changeme

# Client
# ASSET_ROOT_URL: absolute base URL for client assets (boot.js builds URLs as assetRoot + "build/" + file)
ASSET_ROOT_URL=http://__HOST_IP__:3001/hypothesis/
# H_URL: base URL for h (used by boot.js for sidebar/notebook/profile app URLs)
H_URL=http://__HOST_IP__:5000

# Annotation Agent
H_API_URL=http://__HOST_IP__:5000
H_API_TOKEN=__H_API_TOKEN__
ANNOTATION_AGENT_USER=apanoia
ANNOTATION_AGENT_AUTHORITY=__HOST_IP__

# Provider & Model
JAATO_PROVIDER=zhipuai
MODEL_NAME=glm-4.7

# Logs
JAATO_TRACE_LOG=.jaato/logs/annotation_agent_trace.log
JAATO_PROVIDER_TRACE=.jaato/logs/provider_trace.log
RICH_BUFFER_TRACE=
JAATO_SESSION_LOG_DIR=.jaato/logs

# Debug
#VERBOSE=1
AI_USE_CHAT_FUNCTIONS=1

# No timeout on interactive prompts (0 = wait forever)
JAATO_PERMISSION_TIMEOUT=0
JAATO_CLARIFICATION_TIMEOUT=0
