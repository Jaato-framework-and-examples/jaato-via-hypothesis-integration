# Stage 1: Build the Hypothesis client
FROM node:22-alpine AS build

# Tags follow v1.XXXX.0 format — see https://github.com/hypothesis/client/tags
ARG CLIENT_TAG=v1.1746.0

RUN apk add --no-cache git
WORKDIR /build
RUN git clone --depth 1 --branch "$CLIENT_TAG" https://github.com/hypothesis/client.git .
RUN yarn install --immutable
RUN yarn build

# Replace the CDN placeholder with a token that gets substituted at container startup.
# boot.js builds asset URLs as: assetRoot + "build/" + filename
# Replace CDN placeholder and {current_host} URL templates with startup-time tokens
RUN sed -i \
    -e 's|https://cdn.hypothes.is/hypothesis/1.0.0-dummy-version/|__ASSET_ROOT__|g' \
    -e 's|{current_scheme}://{current_host}:5000|__H_URL__|g' \
    build/boot.js

# Stage 2: Serve static assets via nginx
FROM nginx:alpine

RUN mkdir -p /usr/share/nginx/html/hypothesis/build

# boot.js goes at /hypothesis/boot.js (contains __ASSET_ROOT__ placeholder)
COPY --from=build /build/build/boot.js /usr/share/nginx/html/hypothesis/boot.js.template

# Everything else goes under /hypothesis/build/ (scripts/, styles/, etc.)
COPY --from=build /build/build/ /usr/share/nginx/html/hypothesis/build/

# Serve on port 3001 with CORS headers
RUN printf 'server {\n\
    listen 3001;\n\
    root /usr/share/nginx/html;\n\
    location /hypothesis/ {\n\
        try_files $uri $uri/ =404;\n\
        add_header Access-Control-Allow-Origin *;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Entrypoint substitutes placeholders into boot.js then starts nginx
RUN printf '#!/bin/sh\nset -e\nsed -e "s|__ASSET_ROOT__|${ASSET_ROOT_URL}|g" \\\n    -e "s|__H_URL__|${H_URL}|g" \\\n  /usr/share/nginx/html/hypothesis/boot.js.template \\\n  > /usr/share/nginx/html/hypothesis/boot.js\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]

EXPOSE 3001
